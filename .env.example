# Copy to `.env` (gitignored) for local dev; set the same keys in Vercel for prod.
# Leave optional keys blank — the app degrades gracefully. Never commit real values.

# --- Core (required) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000   # canonical origin; auth baseURL, inlined at build
DATABASE_URL=                               # Neon Postgres, POOLED url (dev: a separate branch)
BETTER_AUTH_SECRET=                          # signing secret: openssl rand -base64 32

# --- Auth extras (optional) ---
BETTER_AUTH_TRUSTED_ORIGINS=   # extra comma-separated origins allowed to call the auth API
GITHUB_CLIENT_ID=              # social sign-in appears only when a full pair is set
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) — optional; when unset, links are logged to the console in dev ---
RESEND_API_KEY=
AUTH_FROM_EMAIL=      # sender for verification/reset mail
CONTACT_FROM_EMAIL=   # sender for the contact form
CONTACT_TO_EMAIL=     # inbox for contact messages

# --- Bot protection (reCAPTCHA v3) — optional; skipped when blank ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
POSTHOG_PERSONAL_API_KEY=   # server-only, powers /admin dashboards (scope: query:read)
POSTHOG_PROJECT_ID=

# --- Error monitoring (Sentry) — optional ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=   # build-time source-map upload
SENTRY_API_TOKEN=    # read scopes for the admin Sentry panel

# --- Admin bootstrap — used only by `bun run admin:bootstrap`, never at runtime ---
ADMIN_EMAIL=      # defaults to test@gmail.com
ADMIN_PASSWORD=   # generated + printed once if left blank
