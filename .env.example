# Copy to `.env` (gitignored) for local dev; set the same keys in Vercel for prod.
# Leave optional keys blank — the app degrades gracefully. Never commit real values.

# --- Core (required) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000   # canonical origin; auth baseURL, inlined at build
DATABASE_URL=                               # Neon Postgres, POOLED url (dev: a separate branch)
BETTER_AUTH_SECRET=                          # signing secret: openssl rand -base64 32

# --- Auth extras (optional) ---
BETTER_AUTH_TRUSTED_ORIGINS=   # extra comma-separated origins allowed to call the auth API
GITHUB_CLIENT_ID=              # social sign-in appears only when a full pair is set
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Email (Resend) — optional; when unset, links are logged to the console in dev ---
RESEND_API_KEY=
AUTH_FROM_EMAIL=      # sender for account mail: verification, reset, new-release notices
CONTACT_FROM_EMAIL=   # sender for the contact form
CONTACT_TO_EMAIL=     # inbox for contact messages

# --- Mobile releases — optional; /api/releases/notify answers 503 until the secret is set ---
RELEASE_WEBHOOK_SECRET=   # bearer the mobile repo's release workflow sends: openssl rand -hex 32 (same value in its repo secrets)

# --- Bot protection (reCAPTCHA v3) — optional; skipped when blank ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# --- Analytics (optional) ---
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_POSTHOG_KEY=
# The /admin/analytics dashboards read these server-side; each tab says which
# key it's missing. Heatmaps need nothing extra beyond query:read.
POSTHOG_PERSONAL_API_KEY=   # server-only (scope: query:read)
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=           # read host; default https://us.posthog.com
GA4_PROPERTY_ID=            # numeric, Admin → Property settings
GA4_CREDENTIALS_JSON=       # service-account JSON key, one line (or base64); Viewer on the GA4 property
GSC_SITE_URL=               # sc-domain:metri.info — add the same service account as a Search Console user

# --- Error monitoring (Sentry) — optional ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
SENTRY_AUTH_TOKEN=   # build-time source-map upload
SENTRY_API_TOKEN=    # admin Errors tab: user token with event:read project:read org:read
SENTRY_API_HOST=     # https://de.sentry.io for an EU org; default https://sentry.io

# --- Admin bootstrap — used only by `bun run admin:bootstrap`, never at runtime ---
ADMIN_EMAIL=      # defaults to test@gmail.com
ADMIN_PASSWORD=   # generated + printed once if left blank
